# MSSQL Veritabanı Bağlantı Parametreleri
SERVER=93.177.102.97
DATABASE=Personnel_Attendance_Control

# Kimlik Doğrulama Türü:
# Windows Authentication (Windows Kimlik Doğrulaması) için USE_WINDOWS_AUTH=yes yapın.
# SQL Server Authentication için USE_WINDOWS_AUTH=no yapın ve USERNAME / PASSWORD doldurun.
USE_WINDOWS_AUTH=yes

USERNAME=MCS_Ext
PASSWORD=YourStrongPassword123!

DRIVER=SQL Server
TRUST_SERVER_CERTIFICATE=yes

# Oturum token'larını imzalayan gizli anahtar (canlı ortamda zorunlu; tüm uvicorn worker'ları aynı anahtarı kullanmalı)
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# Oturum süresi (saat)
AUTH_TOKEN_TTL_HOURS=12

# Kiosk: aynı kartın bu süre (saniye) içinde tekrar okutulması yeni kayıt oluşturmaz
KIOSK_DEBOUNCE_SECONDS=60
# Kiosk: bu süreden (saat) eski açık giriş "çıkışı unutulmuş" sayılır; sonraki okutma yeni giriş olur
KIOSK_STALE_CHECKIN_HOURS=16
